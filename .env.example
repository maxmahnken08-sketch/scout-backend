# Copy to .env and fill in. Every key is optional — without it, that provider
# returns realistic stub data so the backend always runs.

# Claude — turns the user's prompt into structured search params
ANTHROPIC_API_KEY=
SCOUT_MODEL=claude-haiku-4-5

# Travelpayouts — RECOMMENDED for indie devs: free, signs up with a personal email,
# covers flights (Aviasales) AND hotels (Hotellook) with affiliate links.
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=

# Amadeus/Duffel — business/enterprise signup (optional, broader/bookable).
# Flights selector order: Amadeus → Duffel → Travelpayouts → stub.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_HOST=https://test.api.amadeus.com
DUFFEL_TOKEN=

# Stays
EXPEDIA_API_KEY=
EXPEDIA_SHARED_SECRET=
BOOKING_AFFILIATE_ID=
BOOKING_TOKEN=

# Activities
GETYOURGUIDE_TOKEN=
VIATOR_API_KEY=

# Ratings & reviews
TRIPADVISOR_API_KEY=

# Server
PORT=8787

# Hotels (LiteAPI / Nuitee) — free sandbox key, no card: https://dashboard.liteapi.travel
LITEAPI_KEY=
